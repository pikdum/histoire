# Source APIs
TVDB_API_KEY=
BRAVE_SEARCH_API_KEY=

# Local development uses the native Codex auth file directly.
HISTOIRE_MATCHING_MODEL=openai_codex:gpt-5.6-luna
CODEX_AUTH_FILE=/home/you/.codex/auth.json

# OpenAI-compatible proxy alternative. The API key may be a non-secret
# placeholder when the proxy authenticates through the network layer.
# HISTOIRE_MATCHING_MODEL=openai/gpt-5.6-luna
# HISTOIRE_MATCHING_BASE_URL=https://ai.snowshoe-bushi.ts.net/v1
# HISTOIRE_MATCHING_API_KEY=tailscale

# Required outside development to expose /admin and /oban.
ADMIN_USERNAME=
ADMIN_PASSWORD=
