# Source APIs
TVDB_API_KEY=
BRAVE_SEARCH_API_KEY=

# Any ReqLLM model specification can be used for matching.
HISTOIRE_MATCHING_MODEL=openai_codex:gpt-5.6-luna

# Preferred for production: a writable ReqLLM oauth.json with an
# "openai-codex" entry. ReqLLM refreshes this file in place.
REQ_LLM_OAUTH_FILE=

# Development fallback: native Codex auth.json. Its current access token is
# read directly; ReqLLM does not rewrite this file.
CODEX_AUTH_FILE=/home/you/.codex/auth.json

# Required outside development to expose /admin and /oban.
ADMIN_USERNAME=
ADMIN_PASSWORD=
